{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "firestore": {
    "rules": "firebase-rules/cutover/firestore.rules"
  },
  "storage": {
    "rules": "firebase-rules/cutover/storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8290
    },
    "storage": {
      "port": 9290
    },
    "auth": {
      "port": 9291
    },
    "ui": {
      "enabled": false
    }
  }
}
