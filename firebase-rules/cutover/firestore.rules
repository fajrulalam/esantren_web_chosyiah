rules_version = '2';

// Lockdown rules for after the phone-login cutover: every santri is signed in
// with Firebase (Google or email link) and carries a `santriId` claim set by the
// linkSantriAccount function, so each santri reaches only their own data.
// Publish with: firebase deploy --only firestore:rules,storage --config firebase.cutover.json
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function staffPath() {
      return /databases/$(database)/documents/PengurusCollection/$(request.auth.uid);
    }

    function staffRole() {
      return signedIn() && exists(staffPath()) ? get(staffPath()).data.role : null;
    }

    function isStaff() {
      return staffRole() in ['pengurus', 'pengasuh', 'superAdmin'];
    }

    function isSuperAdmin() {
      return staffRole() == 'superAdmin';
    }

    function linkedSantriId() {
      return signedIn() && 'santriId' in request.auth.token ? request.auth.token.santriId : null;
    }

    function isSantri() {
      return linkedSantriId() != null;
    }

    function ownsSantri(santriId) {
      return isSantri() && linkedSantriId() == santriId;
    }

    // The bendahara is a santri flagged on their own record, or a staff account
    // with the bendahara role.
    function isBendahara() {
      return staffRole() == 'bendahara' || (isSantri() && santriIsBendahara(linkedSantriId()));
    }

    function santriIsBendahara(santriId) {
      let santri = get(/databases/$(database)/documents/SantriCollection/$(santriId)).data;
      return santri.get('isBendahara', false) == true || santri.get('role', '') == 'bendahara';
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- Santri -------------------------------------------------------------

    match /SantriCollection/{santriId} {
      allow get: if isStaff() || ownsSantri(santriId);
      allow list, create, delete: if isStaff();
      allow update: if isStaff()
        // Izin reports by the santri only move these attendance projections.
        || (ownsSantri(santriId)
            && changesOnly(['statusKehadiran', 'statusKepulangan', 'statusSakit'])
            && (!('statusKehadiran' in request.resource.data)
                || request.resource.data.statusKehadiran in ['Ada', 'Pulang', 'Sakit']));
    }

    match /SakitDanPulangCollection/{izinId} {
      // resource == null: reporting reads the (not yet existing) report in a transaction.
      allow get: if isStaff() || resource == null || ownsSantri(resource.data.santriId);
      allow list: if isStaff() || ownsSantri(resource.data.santriId);
      allow create: if isStaff()
        || (ownsSantri(request.resource.data.santriId)
            && request.resource.data.izinType in ['Pulang', 'Sakit']
            && request.resource.data.status in ['Proses Pulang', 'Dalam Masa Sakit']);
      allow update: if isStaff()
        || (ownsSantri(resource.data.santriId)
            && changesOnly(['status', 'sudahKembali', 'tanggalKembali', 'kembaliSesuaiRencana',
                            'returnReportedBy', 'tanggalSembuh', 'recoveryReportedBy'])
            && request.resource.data.status in ['Sudah Kembali', 'Sudah Sembuh']);
      allow delete: if isStaff();
    }

    match /FacilityReports/{reportId} {
      // Every santri sees all reports, so a problem is reported once.
      allow read: if isStaff() || isSantri();
      allow create: if ownsSantri(request.resource.data.santriId)
        && request.resource.data.id == reportId
        && request.resource.data.status == 'pending'
        && request.resource.data.place is string
        && request.resource.data.place.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 5
        && request.resource.data.resolutionPhotos.size() == 0;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin()
        || (ownsSantri(resource.data.santriId) && resource.data.status == 'pending');
    }

    // ---- Staff accounts -------------------------------------------------------

    match /PengurusCollection/{userId} {
      allow get: if isStaff() || (signedIn() && request.auth.uid == userId);
      allow list: if isStaff()
        // First sign-in: a staff member finds the invitation sent to their email.
        || (signedIn() && resource.data.email == request.auth.token.email)
        // A santri checks whether they hold the bendahara role.
        || (isSantri() && resource.data.santriId == linkedSantriId());
      allow create: if isSuperAdmin() || isInvitationClaim(userId);
      allow update, delete: if isSuperAdmin();
    }

    // The staff member copies the invitation sent to their email to /{uid}.
    function isInvitationClaim(userId) {
      let data = request.resource.data;
      let invite = get(/databases/$(database)/documents/PengurusCollection/$(data.inviteId)).data;
      return signedIn() && request.auth.uid == userId
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.inviteId is string
        && invite.email == request.auth.token.email
        && invite.role == data.role;
    }

    // ---- Money ------------------------------------------------------------------

    match /Invoices/{invoiceId} {
      allow get: if isStaff() || isSantri();
      allow list, write: if isStaff();
    }

    match /PaymentStatuses/{paymentId} {
      allow read: if isStaff() || ownsSantri(resource.data.santriId);
      // Santri payments go through the submitPaymentInstallment function.
      allow write: if isStaff();
    }

    match /CashflowTransactions/{transactionId} {
      allow read, delete: if isStaff() || isBendahara();
      allow create, update: if (isStaff() || isBendahara())
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.account in ['cash', 'emoney']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000;
    }

    match /CashflowSettings/{monthId} {
      allow read: if isStaff() || isBendahara();
      allow create, update: if (isStaff() || isBendahara())
        && request.resource.data.openingCash is number
        && request.resource.data.openingEmoney is number;
    }

    match /vouchers/{voucherId} {
      allow read: if isStaff() || ownsSantri(resource.data.userId);
      allow write: if isSuperAdmin();
    }

    match /voucherGroup/{groupId} {
      allow read, write: if isSuperAdmin();
    }

    // ---- Staff-only operations ------------------------------------------------

    match /AttendanceTypes/{typeId} {
      allow read, write: if isStaff();
    }

    match /AttendanceRecords/{sessionId} {
      allow read, write: if isStaff();
    }

    match /KegiatanCollection/{date} {
      allow read, write: if isStaff();
    }

    // Legacy payment logs (and their per-santri statuses), read by the staff
    // rekapitulasi pages. The code only reads them; Cloud Functions write them.
    match /AktivitasCollection/{kode}/{path=**} {
      allow read: if isStaff();
    }

    // Everything else (e.g. Counters, written by Cloud Functions) is closed to clients.
  }
}
